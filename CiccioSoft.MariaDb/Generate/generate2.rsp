# =======================================================
# Configurazione per ClangSharpPInvokeGenerator
# Generazione binding MariaDb nativi
# =======================================================

# File sorgente C/C++ di input
--file
../include/mysql.h

# header license
--headerFile
license.txt

# Forza ClangSharp a elaborare e generare binding anche per i file inclusi (#include)
--traverse
../include/mariadb_com.h

# Output finale del codice generato
--output
../Native

# Namespace C# di destinazione
--namespace
CiccioSoft.MariaDb.Native

# Nome della DLL/libreria nativa inserito nei [DllImport] (es. sqlite3)
--libraryPath
libmariadb

# Nome della classe statica C# che conterrà i metodi P/Invoke generati
--methodClassName
MariadbComNative

# Linguaggio del codice sorgente di input da analizzare ('c' o 'c++')
--language
c

# Modificatore di accesso per i tipi e metodi C# generati (public/internal)
--with-access-specifier
*=internal
MySqlOption=public
MySqlFieldTypes=public

# Esclude specifiche funzioni, struct o macro dalla generazione (Sintassi: nome)
--exclude
st_mysql
st_mysql_stmt
st_mysql_res
MARIADB_X509_INFO

CLIENT_DEFAULT_FLAGS
SESSION_TRACK_END
SESSION_TRACK_TYPES
SESSION_TRACK_TRANSACTION_TYPE
FIELD_TYPE_CHAR
FIELD_TYPE_INTERVAL
FIELD_TYPE_DECIMAL
FIELD_TYPE_NEWDECIMAL
FIELD_TYPE_TINY
FIELD_TYPE_SHORT
FIELD_TYPE_LONG
FIELD_TYPE_FLOAT
FIELD_TYPE_DOUBLE
FIELD_TYPE_NULL
FIELD_TYPE_TIMESTAMP
FIELD_TYPE_LONGLONG
FIELD_TYPE_INT24
FIELD_TYPE_DATE
FIELD_TYPE_TIME
FIELD_TYPE_DATETIME
FIELD_TYPE_YEAR
FIELD_TYPE_NEWDATE
FIELD_TYPE_ENUM
FIELD_TYPE_SET
FIELD_TYPE_TINY_BLOB
FIELD_TYPE_MEDIUM_BLOB
FIELD_TYPE_LONG_BLOB
FIELD_TYPE_BLOB
FIELD_TYPE_VAR_STRING
FIELD_TYPE_STRING
FIELD_TYPE_GEOMETRY
FIELD_TYPE_BIT
IS_MARIADB_EXTENDED_SERVER
net_new_transaction

# Rinomina un tipo nativo in un nome C# personalizzato (Sintassi: vecchio=nuovo)
--remap
char=byte
MYSQL_ROW=nint
enum_field_types=MySqlFieldTypes
mysql_option=MySqlOption

# Passa opzioni di configurazione avanzate
--config
multi-file
generate-macro-bindings
latest-codegen
